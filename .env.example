# ─── LLM Providers ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── AWS ──────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
AWS_DEFAULT_REGION=us-east-2
AWS_ACCOUNT_ID=574772738370

# S3 / SQS / Step Functions (populated by aws/setup.py)
S3_BUCKET=documind-documents-574772738370
SQS_QUEUE_URL=https://sqs.us-east-2.amazonaws.com/574772738370/documind-ingestion-queue
STATE_MACHINE_ARN=arn:aws:states:us-east-2:574772738370:stateMachine:documind-ingestion-pipeline
DOCUMIND_EC2_IP=

# ─── RDS / pgvector ───────────────────────────────────────────────────────────
# NOTE: DocuMind uses a SEPARATE RDS instance from any other projects.
# TEARDOWN when not demoing: aws rds stop-db-instance --db-instance-identifier documind-db
RDS_HOST=documind-db.XXXXX.us-east-2.rds.amazonaws.com
RDS_DB=documind
RDS_USER=documindadmin
RDS_PASSWORD=changeme
DATABASE_URL=postgresql://documindadmin:changeme@documind-db.XXXXX.us-east-2.rds.amazonaws.com:5432/documind
DATABASE_URL_ASYNC=postgresql://documindadmin:changeme@documind-db.XXXXX.us-east-2.rds.amazonaws.com:5432/documind

# ─── Local dev (Docker) ───────────────────────────────────────────────────────
# Used only for local development; production uses AWS RDS + EC2
# DATABASE_URL=postgresql://documind:documind_secret@localhost:5432/documind
# DATABASE_URL_ASYNC=postgresql://documind:documind_secret@localhost:5432/documind
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=documind_chunks
REDIS_URL=redis://localhost:6379

# ─── Embedding mode (no GPU required) ─────────────────────────────────────────
# local  → bge-small-en-v1.5, 384-dim, free, CPU
# bedrock → Titan Embed Text v2, 1536-dim, ~$0.00002/1K tokens (~$0.10/month)
EMBEDDING_MODE=local
LOCAL_EMBED_MODEL=BAAI/bge-small-en-v1.5

# ─── LLM mode ─────────────────────────────────────────────────────────────────
# bedrock → Claude Haiku on Bedrock (~$2/month for 500 research runs)
# anthropic → direct Anthropic SDK (fallback)
LLM_PROVIDER=bedrock
BEDROCK_MODEL=haiku

# ─── Feature flags ────────────────────────────────────────────────────────────
TEXTRACT_ENABLED=true       # set false to use basic PyMuPDF parser (no cost)
COMPREHEND_ENABLED=true     # entity extraction (~$0.05/month)
GUARDRAILS_ENABLED=true     # Pydantic output validation

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_in_production
