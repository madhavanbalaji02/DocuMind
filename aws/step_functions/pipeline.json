{
  "Comment": "DocuMind 3-stage document ingestion pipeline: Parse \u2192 Embed \u2192 Store",
  "StartAt": "Stage1_Parse",
  "States": {
    "Stage1_Parse": {
      "Type": "Task",
      "Comment": "Textract layout-aware parsing ($0.015/page tables, $0.0015/page text)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "documind-stage1-parse",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "Stage2_Embed",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.TooManyRequestsException",
            "Lambda.ServiceException",
            "Lambda.SdkClientException"
          ],
          "MaxAttempts": 3,
          "IntervalSeconds": 30,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "MarkFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "Stage2_Embed": {
      "Type": "Task",
      "Comment": "Hierarchical chunking + Bedrock Titan v2 embeddings (1024-dim)",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "documind-stage2-embed",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "Stage3_Store",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 2,
          "IntervalSeconds": 10,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "MarkFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "Stage3_Store": {
      "Type": "Task",
      "Comment": "Comprehend entities + chunk index to S3 (indexed/) + metadata to DynamoDB",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "documind-stage3-store",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Next": "MarkReady",
      "Retry": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "MaxAttempts": 2,
          "IntervalSeconds": 5
        }
      ],
      "Catch": [
        {
          "ErrorEquals": [
            "States.ALL"
          ],
          "Next": "MarkFailed",
          "ResultPath": "$.error"
        }
      ]
    },
    "MarkReady": {
      "Type": "Task",
      "Comment": "Mark job as ready in DynamoDB",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "documind-jobs",
        "Key": {
          "s3_key": {
            "S.$": "$.s3_key"
          }
        },
        "UpdateExpression": "SET #s = :ready, #cc = :chunks",
        "ExpressionAttributeNames": {
          "#s": "status",
          "#cc": "chunk_count"
        },
        "ExpressionAttributeValues": {
          ":ready": {
            "S": "ready"
          },
          ":chunks": {
            "N.$": "States.Format('{}', $.total_chunks)"
          }
        }
      },
      "End": true
    },
    "MarkFailed": {
      "Type": "Task",
      "Comment": "Mark job as failed in DynamoDB",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "documind-jobs",
        "Key": {
          "s3_key": {
            "S.$": "$.s3_key"
          }
        },
        "UpdateExpression": "SET #s = :failed, #e = :err",
        "ExpressionAttributeNames": {
          "#s": "status",
          "#e": "error"
        },
        "ExpressionAttributeValues": {
          ":failed": {
            "S": "failed"
          },
          ":err": {
            "S.$": "$.error.Cause"
          }
        }
      },
      "End": true
    }
  }
}
